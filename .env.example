# Статический ключ, его ждут все эндпоинты в заголовке X-API-Key
API_KEY=local-api-key

# PostgreSQL
DB__HOST=localhost
DB__PORT=5432
DB__USER=payments
DB__PASSWORD=payments
DB__NAME=payments
DB__ECHO=false
DB_HOST_PORT=5432

# RabbitMQ
RABBIT__HOST=localhost
RABBIT__PORT=5672
RABBIT__USER=guest
RABBIT__PASSWORD=guest
RABBIT_HOST_PORT=5672
RABBIT_MANAGEMENT_PORT=15672

# API
API_HOST_PORT=8000

# Эмуляция платёжного шлюза: задержка обработки и доля успешных платежей
GATEWAY__MIN_DELAY=2
GATEWAY__MAX_DELAY=5
GATEWAY__SUCCESS_RATE=0.9

# Отправка webhook: 3 попытки с задержками 1, 2, 4 секунды
WEBHOOK__TIMEOUT=5
WEBHOOK__MAX_ATTEMPTS=3
WEBHOOK__INITIAL_DELAY=1

# Релей outbox
OUTBOX__BATCH_SIZE=100
OUTBOX__POLL_INTERVAL=1

# Consumer: сколько сообщений брать в работу одновременно
CONSUMER__PREFETCH_COUNT=10

LOG_LEVEL=INFO
